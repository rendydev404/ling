# =============================================
# Ling — Single-Creator Storefront Environment
# =============================================

# Public Application URL (used for redirects, referral links, Midtrans callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Midtrans Payment Gateway (Sandbox by default; set MIDTRANS_IS_PRODUCTION=true for Production)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=Gxxxxxxxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_SIGNATURE_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
# Core API channels shown at checkout (comma separated). Empty = all:
# qris,gopay,shopeepay,bca_va,bni_va,bri_va,mandiri_bill,permata_va,cimb_va
MIDTRANS_ENABLED_METHODS=

# Email akses produk otomatis setelah bayar. Pilih salah satu:
# (A) Gmail SMTP: SMTP_USER = alamat Gmail, SMTP_PASS = App Password 16 huruf
#     (Akun Google > Keamanan > Verifikasi 2 Langkah > Sandi aplikasi). Batas ±500 email/hari.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# (B) Resend (https://resend.com), domain pengirim harus diverifikasi
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Nama pengirim. Dengan Gmail cukup nama toko, alamatnya otomatis = SMTP_USER
EMAIL_FROM="Ling Studio"
EMAIL_REPLY_TO=
# Kunci tanda tangan link akses produk (min. 16 karakter; kosong = pakai SUPABASE_SERVICE_ROLE_KEY)
ORDER_ACCESS_SECRET=

# ---------------------------------------------------------------------------
# Ebook Reader (Google Drive Link Proxy — Tanpa OAuth / API Key)
# File PDF diunggah ke Google Drive biasa dengan akses "Siapa saja yang memiliki link (Pelihat)",
# lalu link-nya ditempel di menu Admin > Ebook & Reader. Server otomatis mem-proxy stream PDF
# sehingga link asli Google Drive tidak pernah terlihat di browser member.
# Kunci tanda tangan sesi reader (min. 16 karakter; kosong = pakai ORDER_ACCESS_SECRET / service role key)
READER_TOKEN_SECRET=
