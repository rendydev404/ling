# =============================================
# Ling — Single-Creator Storefront Environment
# =============================================

# Public Application URL (used for redirects, referral links, Midtrans callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Midtrans Payment Gateway (Sandbox by default; set MIDTRANS_IS_PRODUCTION=true for Production)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=Gxxxxxxxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_SIGNATURE_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
# Core API channels shown at checkout (comma separated). Empty = all:
# qris,gopay,shopeepay,bca_va,bni_va,bri_va,mandiri_bill,permata_va,cimb_va
MIDTRANS_ENABLED_METHODS=

# Email akses produk otomatis setelah bayar (Resend: https://resend.com, verifikasi domain pengirim)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Ling Studio <halo@domainkamu.com>"
EMAIL_REPLY_TO=
# Kunci tanda tangan link akses produk (min. 16 karakter; kosong = pakai SUPABASE_SERVICE_ROLE_KEY)
ORDER_ACCESS_SECRET=
